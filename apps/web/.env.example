# Copy to .env.local and adjust if needed. Never commit .env.local.
#
# Next.js inlines every NEXT_PUBLIC_ value into the browser bundle at build time,
# so this has to be set when building, not only when starting. The default below
# is what local development uses; set it to the tunnel or production API
# ("https://api.languze.com") when building against those.
NEXT_PUBLIC_API_URL="http://localhost:4001"
