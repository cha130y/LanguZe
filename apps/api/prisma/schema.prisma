// LanguZe database schema. Prisma schema + migrations are the database source of truth.
// Tables and columns follow docs/architecture/data-model.md: singular PascalCase models,
// plural snake_case tables, snake_case columns, UUID version 7 keys, UTC timestamps.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEARNER
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED

  @@map("account_status")
}

/// One row per account, learner or admin. Managed by Better Auth (ADR-0003).
model User {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// Display name, 1-50 characters (V12, V19).
  name            String        @db.VarChar(50)
  /// A placeholder ending in .invalid for accounts without an email address (D1).
  email           String        @unique @db.VarChar(254)
  emailVerified   Boolean       @default(false) @map("email_verified")
  /// Better Auth field; left empty, since LanguZe shows no profile pictures.
  image           String?
  role            UserRole      @default(LEARNER)
  status          AccountStatus @default(ACTIVE)
  /// Empty only for a pending provider sign-up, removed after 15 minutes (FR-090, U5).
  termsAcceptedAt DateTime?     @map("terms_accepted_at") @db.Timestamptz(3)
  /// Year of birth given at sign-up; learners must turn 18 this year (FR-090, V20).
  birthYear       Int?          @map("birth_year") @db.SmallInt
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts         Account[]
  sessions         Session[]
  photos           StoredPhoto[]
  worlds           World[]
  analyses         Analysis[]
  words            VocabularyWord[]
  photoBlocks      PhotoBlock[]
  mastery          WordMastery[]
  practiceSessions PracticeSession[]
  attempts         Attempt[]
  xp               LearnerXp?

  @@map("users")
}

/// A signed-in browser. Deleted on sign-out, password reset, suspension, and account deletion.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A way to sign in: the email password, or a Google, LINE, or Facebook identity.
/// Provider tokens are left empty on purpose (D3).
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  /// `credential`, `google`, `line`, or `facebook`.
  providerId            String    @map("provider_id")
  /// The provider's user ID; for `credential`, the user's own ID.
  accountId             String    @map("account_id")
  /// Password hash, for `credential` only.
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

/// Single-use tokens for email verification and password reset (FR-004, FR-005).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

enum PhotoKind {
  /// The photo a learner sees and the AI receives: at most 2,048 pixels (FR-017, V18).
  PREPARED
  /// The small copy the world list shows (FR-013).
  THUMBNAIL

  @@map("photo_kind")
}

enum PhotoDeletionReason {
  WORLD_DELETED
  ACCOUNT_DELETED
  PHOTO_BLOCKED
  UPLOAD_FAILED

  @@map("photo_deletion_reason")
}

/// Every photo file LanguZe keeps in photo storage (FR-017). The file itself lives in
/// object storage; this row is what the API knows about it.
model StoredPhoto {
  id          String    @id @default(uuid(7)) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  /// Random key of the object in photo storage; never derived from learner data.
  storageKey  String    @unique @map("storage_key") @db.VarChar(200)
  kind        PhotoKind
  contentType String    @map("content_type") @db.VarChar(50)
  width       Int
  height      Int
  byteSize    Int       @map("byte_size")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  owner          User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  worldPhoto     World? @relation("WorldPhoto")
  worldThumbnail World? @relation("WorldThumbnail")

  @@index([ownerId])
  @@map("stored_photos")
}

/// A photo still to be removed from photo storage (NFR-009, V10). Written in the same
/// transaction as the deletion that causes it, so nothing is forgotten when a request
/// or the API fails; a scheduled task deletes the object and then this row.
model PhotoDeletion {
  id            String              @id @default(uuid(7)) @db.Uuid
  /// No foreign key on purpose: the owner and the photo row may already be gone.
  storageKey    String              @map("storage_key") @db.VarChar(200)
  reason        PhotoDeletionReason
  requestedAt   DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?             @map("last_error") @db.VarChar(500)

  @@index([nextAttemptAt])
  @@map("photo_deletions")
}

enum WorldStatus {
  ANALYZING
  READY
  FAILED

  @@map("world_status")
}

enum AnalysisFailure {
  /// The photo broke the content rules and was deleted (FR-092).
  BLOCKED
  TOO_FEW_WORDS
  PROVIDER_ERROR
  INVALID_OUTPUT
  TIMED_OUT

  @@map("analysis_failure")
}

/// A place a learner photographed, and the words found in it (FR-010–FR-017).
model World {
  id            String           @id @default(uuid(7)) @db.Uuid
  learnerId     String           @map("learner_id") @db.Uuid
  /// 1–50 characters (V3).
  name          String           @db.VarChar(50)
  status        WorldStatus      @default(ANALYZING)
  /// Set when FAILED; decides the message and whether a retry is offered.
  failureReason AnalysisFailure? @map("failure_reason")
  /// Empty after a blocked photo is deleted (FR-092).
  photoId       String?          @unique @map("photo_id") @db.Uuid
  thumbnailId   String?          @unique @map("thumbnail_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  learner     User              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  photo       StoredPhoto?      @relation("WorldPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  thumbnail   StoredPhoto?      @relation("WorldThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  analyses    Analysis[]
  occurrences WordOccurrence[]
  sessions    PracticeSession[]

  @@index([learnerId, createdAt])
  @@map("worlds")
}

enum AnalysisStatus {
  IN_PROGRESS
  SUCCEEDED
  /// The photo broke the content rules; it counts toward the daily limit (FR-093).
  BLOCKED
  /// LanguZe or its provider failed, so the analysis is not counted (FR-025).
  FAILED

  @@map("analysis_status")
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("cefr_level")
}

enum BlockCategory {
  SEXUAL_CONTENT
  SUSPECTED_ILLEGAL_MATERIAL
  VIOLENCE
  ILLEGAL_ACTIVITY
  HATE_SYMBOL
  PERSONAL_DATA
  OTHER

  @@map("block_category")
}

enum AiPurpose {
  SAFETY_CHECK
  EXTRACTION
  TUTOR

  @@map("ai_purpose")
}

enum AiOutcome {
  SUCCEEDED
  FAILED
  TIMED_OUT
  INVALID_OUTPUT

  @@map("ai_outcome")
}

/// One analysis run of one photo, which is also what the daily limit counts
/// (FR-020, U2). It outlives its world, so deleting a world cannot give an
/// analysis back.
model Analysis {
  id            String           @id @default(uuid(7)) @db.Uuid
  learnerId     String           @map("learner_id") @db.Uuid
  worldId       String?          @map("world_id") @db.Uuid
  status        AnalysisStatus   @default(IN_PROGRESS)
  failureReason AnalysisFailure? @map("failure_reason")
  startedAt     DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?        @map("finished_at") @db.Timestamptz(3)

  learner User   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  world   World? @relation(fields: [worldId], references: [id], onDelete: SetNull)

  @@index([learnerId, startedAt])
  @@index([status, startedAt])
  @@map("analyses")
}

/// A learner's word, identified by the English word and the Thai meaning (FR-043).
model VocabularyWord {
  id             String   @id @default(uuid(7)) @db.Uuid
  learnerId      String   @map("learner_id") @db.Uuid
  /// Normalized, singular base form (SRS 4.2, AIR-003).
  english        String   @db.VarChar(40)
  thaiMeaning    String   @map("thai_meaning") @db.VarChar(100)
  /// The Thai meaning with outer spaces removed and inner spaces collapsed, so two
  /// spellings of the same meaning are one word.
  thaiMeaningKey String   @map("thai_meaning_key") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  learner     User              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  occurrences WordOccurrence[]
  mastery     WordMastery?
  questions   SessionQuestion[]
  attempts    Attempt[]

  @@unique([learnerId, english, thaiMeaningKey])
  @@map("vocabulary_words")
}

/// One word as it appears in one world's photo, with the box that highlights it.
model WordOccurrence {
  id               String    @id @default(uuid(7)) @db.Uuid
  worldId          String    @map("world_id") @db.Uuid
  vocabularyWordId String    @map("vocabulary_word_id") @db.Uuid
  /// Relative to the prepared photo, so resizing never moves the box (AIR-003).
  boxX             Float     @map("box_x")
  boxY             Float     @map("box_y")
  boxWidth         Float     @map("box_width")
  boxHeight        Float     @map("box_height")
  exampleSentence  String    @map("example_sentence") @db.VarChar(200)
  cefrLevel        CefrLevel @map("cefr_level")
  /// Other answers the game accepts; normalized, at most 10, never the word itself.
  acceptedVariants String[]  @map("accepted_variants") @db.VarChar(40)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  world          World             @relation(fields: [worldId], references: [id], onDelete: Cascade)
  vocabularyWord VocabularyWord    @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)
  questions      SessionQuestion[]
  attempts       Attempt[]

  @@unique([worldId, vocabularyWordId])
  @@index([vocabularyWordId])
  @@map("word_occurrences")
}

/// That a learner's photo was blocked, and why — never the photo itself (FR-095).
model PhotoBlock {
  id        String        @id @default(uuid(7)) @db.Uuid
  learnerId String        @map("learner_id") @db.Uuid
  category  BlockCategory
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  learner User @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
  @@map("photo_blocks")
}

/// What one AI call cost and how it went (AIR-007). Holds no learner identifier,
/// photo, prompt, or message text, which is why it has no foreign key.
model AiCall {
  id           String    @id @default(uuid(7)) @db.Uuid
  purpose      AiPurpose
  provider     String    @db.VarChar(50)
  model        String    @db.VarChar(100)
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  latencyMs    Int       @map("latency_ms")
  inputTokens  Int?      @map("input_tokens")
  outputTokens Int?      @map("output_tokens")
  outcome      AiOutcome
  errorCode    String?   @map("error_code") @db.VarChar(100)
  /// Links the call to the API's request logs (NFR-016).
  requestId    String?   @map("request_id") @db.VarChar(100)

  @@index([startedAt])
  @@map("ai_calls")
}

enum MasteryLevel {
  LEARNING
  FAMILIAR
  MASTERED

  @@map("mastery_level")
}

enum SessionKind {
  GAME
  REVIEW

  @@map("session_kind")
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  /// Left unfinished: 24 hours passed, or a new session replaced it (V17, FR-036).
  ABANDONED

  @@map("session_status")
}

/// How well a learner knows one word, shared by every world of theirs that has it
/// (FR-040, SRS 4.1). No row means `NEW`: the first attempt creates it, so photo
/// analysis never writes learning data.
model WordMastery {
  vocabularyWordId String       @id @map("vocabulary_word_id") @db.Uuid
  /// Copied from the word so review can ask by learner without a join (FR-050).
  learnerId        String       @map("learner_id") @db.Uuid
  level            MasteryLevel
  /// Correct answers in a row at the current level (SRS 4.1).
  streak           Int          @default(0) @db.SmallInt
  /// The Asia/Bangkok day the word last became FAMILIAR; a second correct answer
  /// on that same day must not count toward MASTERED (SRS 4.1, V1).
  familiarOn       DateTime?    @map("familiar_on") @db.Date
  lastPractisedAt  DateTime     @map("last_practised_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  vocabularyWord VocabularyWord @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)
  learner        User           @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, level])
  @@map("word_mastery")
}

/// One sitting of practice, for a world (`GAME`) or across worlds (`REVIEW`).
model PracticeSession {
  id          String        @id @default(uuid(7)) @db.Uuid
  learnerId   String        @map("learner_id") @db.Uuid
  kind        SessionKind
  /// Set for a game only. Kept as a session when the world goes (FR-036).
  worldId     String?       @map("world_id") @db.Uuid
  status      SessionStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?     @map("completed_at") @db.Timestamptz(3)

  learner   User              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  world     World?            @relation(fields: [worldId], references: [id], onDelete: SetNull)
  questions SessionQuestion[]
  attempts  Attempt[]

  @@index([learnerId, startedAt])
  @@map("practice_sessions")
}

/// The questions of a session, fixed when it is created, in the order they are asked.
model SessionQuestion {
  id               String  @id @default(uuid(7)) @db.Uuid
  sessionId        String  @map("session_id") @db.Uuid
  /// 1 to 10, the order the learner sees.
  position         Int     @db.SmallInt
  /// Emptied when the word or its occurrence goes; the question is then skipped.
  vocabularyWordId String? @map("vocabulary_word_id") @db.Uuid
  occurrenceId     String? @map("occurrence_id") @db.Uuid

  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vocabularyWord VocabularyWord? @relation(fields: [vocabularyWordId], references: [id], onDelete: SetNull)
  occurrence     WordOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  attempt        Attempt?

  @@unique([sessionId, position])
  @@map("session_questions")
}

/// One answer (FR-034). An incorrect attempt is also the learner's mistake record
/// (FR-042), which is why it keeps what they typed.
model Attempt {
  id               String   @id @default(uuid(7)) @db.Uuid
  learnerId        String   @map("learner_id") @db.Uuid
  vocabularyWordId String   @map("vocabulary_word_id") @db.Uuid
  /// Unique, so one question can never hold two attempts (FR-034, S5).
  questionId       String?  @unique @map("question_id") @db.Uuid
  sessionId        String?  @map("session_id") @db.Uuid
  occurrenceId     String?  @map("occurrence_id") @db.Uuid
  /// What the learner typed, up to 100 characters; empty for "I don't know" (V19).
  answerText       String?  @map("answer_text") @db.VarChar(100)
  isDontKnow       Boolean  @default(false) @map("is_dont_know")
  isCorrect        Boolean  @map("is_correct")
  /// 10 for a correct answer, 0 otherwise (FR-060).
  xpAwarded        Int      @default(0) @map("xp_awarded") @db.SmallInt
  answeredAt       DateTime @default(now()) @map("answered_at") @db.Timestamptz(3)

  learner        User             @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  vocabularyWord VocabularyWord   @relation(fields: [vocabularyWordId], references: [id], onDelete: Cascade)
  question       SessionQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  session        PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  occurrence     WordOccurrence?  @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@index([learnerId, answeredAt])
  @@index([vocabularyWordId, answeredAt])
  @@map("attempts")
}

/// Total XP, kept apart from the attempts that earned it so that deleting a world
/// or a word never takes points away (FR-060, V4).
model LearnerXp {
  learnerId String   @id @map("learner_id") @db.Uuid
  totalXp   Int      @default(0) @map("total_xp")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  learner User @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@map("learner_xp")
}
