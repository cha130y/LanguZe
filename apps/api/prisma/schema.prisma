// LanguZe database schema. Prisma schema + migrations are the database source of truth.
// Tables and columns follow docs/architecture/data-model.md: singular PascalCase models,
// plural snake_case tables, snake_case columns, UUID version 7 keys, UTC timestamps.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEARNER
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED

  @@map("account_status")
}

/// One row per account, learner or admin. Managed by Better Auth (ADR-0003).
model User {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// Display name, 1-50 characters (V12, V19).
  name            String        @db.VarChar(50)
  /// A placeholder ending in .invalid for accounts without an email address (D1).
  email           String        @unique @db.VarChar(254)
  emailVerified   Boolean       @default(false) @map("email_verified")
  /// Better Auth field; left empty, since LanguZe shows no profile pictures.
  image           String?
  role            UserRole      @default(LEARNER)
  status          AccountStatus @default(ACTIVE)
  /// Empty only for a pending provider sign-up, removed after 15 minutes (FR-090, U5).
  termsAcceptedAt DateTime?     @map("terms_accepted_at") @db.Timestamptz(3)
  /// Year of birth given at sign-up; learners must turn 18 this year (FR-090, V20).
  birthYear       Int?          @map("birth_year") @db.SmallInt
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts Account[]
  sessions Session[]
  photos   StoredPhoto[]

  @@map("users")
}

/// A signed-in browser. Deleted on sign-out, password reset, suspension, and account deletion.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A way to sign in: the email password, or a Google, LINE, or Facebook identity.
/// Provider tokens are left empty on purpose (D3).
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  /// `credential`, `google`, `line`, or `facebook`.
  providerId            String    @map("provider_id")
  /// The provider's user ID; for `credential`, the user's own ID.
  accountId             String    @map("account_id")
  /// Password hash, for `credential` only.
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

/// Single-use tokens for email verification and password reset (FR-004, FR-005).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

enum PhotoKind {
  /// The photo a learner sees and the AI receives: at most 2,048 pixels (FR-017, V18).
  PREPARED
  /// The small copy the world list shows (FR-013).
  THUMBNAIL

  @@map("photo_kind")
}

enum PhotoDeletionReason {
  WORLD_DELETED
  ACCOUNT_DELETED
  PHOTO_BLOCKED
  UPLOAD_FAILED

  @@map("photo_deletion_reason")
}

/// Every photo file LanguZe keeps in photo storage (FR-017). The file itself lives in
/// object storage; this row is what the API knows about it.
model StoredPhoto {
  id          String    @id @default(uuid(7)) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  /// Random key of the object in photo storage; never derived from learner data.
  storageKey  String    @unique @map("storage_key") @db.VarChar(200)
  kind        PhotoKind
  contentType String    @map("content_type") @db.VarChar(50)
  width       Int
  height      Int
  byteSize    Int       @map("byte_size")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("stored_photos")
}

/// A photo still to be removed from photo storage (NFR-009, V10). Written in the same
/// transaction as the deletion that causes it, so nothing is forgotten when a request
/// or the API fails; a scheduled task deletes the object and then this row.
model PhotoDeletion {
  id            String              @id @default(uuid(7)) @db.Uuid
  /// No foreign key on purpose: the owner and the photo row may already be gone.
  storageKey    String              @map("storage_key") @db.VarChar(200)
  reason        PhotoDeletionReason
  requestedAt   DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?             @map("last_error") @db.VarChar(500)

  @@index([nextAttemptAt])
  @@map("photo_deletions")
}
