# Copy to .env and fill in the values. Never commit .env.
# Only DATABASE_URL and AUTH_SECRET are required; everything else has a default.

# Runtime
NODE_ENV=development
PORT=4001

# Database (matches docker-compose)
DATABASE_URL="postgresql://languze:languze@localhost:5435/languze"
# Production only: Neon's direct (unpooled) URL, used by prisma migrate deploy.
# Locally there is one endpoint, so this stays unset.
# DATABASE_URL_UNPOOLED=

# Browser origin allowed by CORS (the web app)
WEB_ORIGIN="http://localhost:3003"

# Usage limits (optional; these are the defaults)
WORLD_LIMIT=20
DAILY_ANALYSIS_LIMIT=10
DAILY_TUTOR_MESSAGE_LIMIT=30
RATE_LIMIT_PER_MINUTE=120

# Sign-in (ADR-0003). Generate the secret yourself, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:4001"

# The domain the session cookie is set on, so the web app and the API can both
# read it (H5). Leave empty for localhost, where the two already share a host.
# Set to ".languze.com" when serving over the tunnel or in production.
COOKIE_DOMAIN=

# Email — Maildev from docker-compose, which accepts anonymous mail
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_FROM="LanguZe <no-reply@languze.local>"
# Credentials for a real provider; empty for Maildev.
# With Resend: MAIL_USER=resend and MAIL_PASSWORD is an API key.
MAIL_USER=
MAIL_PASSWORD=

# Provider sign-in (optional). Each provider is offered only when both of its
# values are set; without them the API starts normally and simply does not offer it.
# Setup steps for both: docs/deployment/local-development.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE Login, one channel for Thailand. Channel ID and Channel secret.
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# What the fake AI provider does, so each path can be seen without a real key (B4):
# ALLOWED, BLOCKED, PROVIDER_ERROR, TIMED_OUT, TOO_FEW_WORDS, or INVALID_OUTPUT.
AI_FAKE_BEHAVIOUR=ALLOWED

# Photo storage (A3). These defaults match the SeaweedFS service in docker-compose;
# production uses Cloudflare R2 (docs/deployment/production.md).
STORAGE_ENDPOINT="http://localhost:8334"
STORAGE_REGION=auto
STORAGE_BUCKET=languze-photos
STORAGE_ACCESS_KEY_ID=languze
STORAGE_SECRET_ACCESS_KEY=languze
# How long a photo link works in the browser, in seconds (P4).
PHOTO_LINK_TTL_SECONDS=900
