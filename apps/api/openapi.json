  "info": {
    "title": "LanguZe API",
    "description": "Endpoints used by the LanguZe web app.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "WorldSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ANALYZING",
              "READY",
              "FAILED"
            ]
          },
          "failureReason": {
            "type": "string",
            "nullable": true,
            "description": "Why the analysis failed, when it did."
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "A signed link to the thumbnail, valid for a few minutes (P4). Empty when the photo is gone."
          },
          "wordCount": {
            "type": "number",
            "description": "Words found in this world (FR-013)."
          },
          "masteredCount": {
            "type": "number",
            "description": "Of those, the ones the learner has mastered."
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "wordCount",
          "masteredCount",
          "createdAt"
        ]
      },
      "HighlightBoxDto": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ]
      },
      "WorldWordDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifies this word in this world (FR-026)."
          },
          "english": {
            "type": "string"
          },
          "thaiMeaning": {
            "type": "string"
          },
          "exampleSentence": {
            "type": "string"
          },
          "cefrLevel": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          },
          "box": {
            "$ref": "#/components/schemas/HighlightBoxDto"
          },
          "mastery": {
            "type": "string",
            "description": "What the learner has to do with this word to master it.",
            "enum": [
              "NEW",
              "LEARNING",
              "FAMILIAR",
              "MASTERED"
            ]
          }
        },
        "required": [
          "id",
          "english",
          "thaiMeaning",
          "exampleSentence",
          "cefrLevel",
          "box",
          "mastery"
        ]
      },
      "WorldDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ANALYZING",
              "READY",
              "FAILED"
            ]
          },
          "failureReason": {
            "type": "string",
            "nullable": true,
            "description": "Why the analysis failed, when it did."
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "A signed link to the thumbnail, valid for a few minutes (P4). Empty when the photo is gone."
          },
          "wordCount": {
            "type": "number",
            "description": "Words found in this world (FR-013)."
          },
          "masteredCount": {
            "type": "number",
            "description": "Of those, the ones the learner has mastered."
          },
          "createdAt": {
            "type": "string"
          },
          "photoUrl": {
            "type": "string",
            "nullable": true,
            "description": "A signed link to the prepared photo (P4)."
          },
          "words": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorldWordDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "wordCount",
          "masteredCount",
          "createdAt",
          "words"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "VALIDATION_FAILED",
              "NOT_SIGNED_IN",
              "FORBIDDEN",
              "ORIGIN_NOT_ALLOWED",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE",
              "TERMS_NOT_ACCEPTED",
              "MESSAGE_TOO_LONG",
              "ACCOUNT_SUSPENDED",
              "TERMS_PENDING",
              "AGE_BELOW_MINIMUM",
              "NOT_VERIFIED",
              "AI_SUSPENDED",
              "OWN_ACCOUNT",
              "INVALID_CREDENTIALS",
              "INVALID_TOKEN",
              "EMAIL_ALREADY_REGISTERED",
              "WORLD_LIMIT_REACHED",
              "WORLD_NOT_READY",
              "RETRY_NOT_AVAILABLE",
              "LAST_WORD",
              "NOTHING_TO_REVIEW",
              "SESSION_CLOSED",
              "QUESTION_UNAVAILABLE",
              "ACTION_NOT_APPLICABLE",
              "PHOTO_TOO_LARGE",
              "PHOTO_TYPE_NOT_ALLOWED",
              "DAILY_ANALYSIS_LIMIT",
              "DAILY_TUTOR_LIMIT",
              "AI_PROVIDER_UNAVAILABLE"
            ]
          },
          "message": {
            "type": "string",
            "description": "English, for developers; never shown to learners as is."
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "WorldStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ANALYZING",
              "READY",
              "FAILED"
            ]
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "status"
        ]
      },
      "RenameWorldDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "required": [
          "name"
        ]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Cannot be a placeholder address (D1)."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "At least 8 characters (V2)."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Display name (V12, V19)."
          },
          "birthYear": {
            "type": "number",
            "description": "Year of birth; the learner must turn 18 this year (V20)."
          },
          "acceptTerms": {
            "type": "boolean",
            "description": "Must be true: accepting the Terms of Use and Privacy Policy (FR-090). False is answered with TERMS_NOT_ACCEPTED."
          }
        },
        "required": [
          "email",
          "password",
          "name",
          "birthYear",
          "acceptTerms"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AiAccessDto": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "NOT_VERIFIED",
              "AI_SUSPENDED"
            ],
            "nullable": true,
            "description": "Why AI features are unavailable, if they are."
          }
        },
        "required": [
          "available"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The account ID a learner can quote to LanguZe (FR-108)."
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "description": "Empty for accounts without an email address (D1)."
          },
          "emailVerified": {
            "type": "boolean"
          },
          "verifiedForAi": {
            "type": "boolean",
            "description": "Whether photo analysis and the tutor are unlocked (SRS 1.3)."
          },
          "role": {
            "type": "string",
            "enum": [
              "LEARNER",
              "ADMIN"
            ]
          },
          "termsAccepted": {
            "type": "boolean",
            "description": "False while a provider sign-up has not accepted the Terms (FR-090)."
          },
          "aiAccess": {
            "$ref": "#/components/schemas/AiAccessDto"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "emailVerified",
          "verifiedForAi",
          "role",
          "termsAccepted",
          "aiAccess"
        ]
      },
      "EmailOnlyDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "AcknowledgementDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the verification link."
          }
        },
        "required": [
          "token"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the reset link."
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ProvidersResponseDto": {
        "type": "object",
        "properties": {
          "providers": {
            "example": [
              "google",
              "line"
            ],
            "description": "The providers with credentials configured, in the order to show them.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "providers"
        ]
      },
      "AcceptTermsDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Display name, prefilled from the provider profile (V12, V19)."
          },
          "birthYear": {
            "type": "number",
            "description": "Year of birth; the learner must turn 18 this year (V20)."
          }
        },
        "required": [
          "name",
          "birthYear"
        ]
      },
      "UsageResponseDto": {
        "type": "object",
        "properties": {
          "analysesLeft": {
            "type": "number",
            "description": "Photo analyses left today."
          },
          "analysesLimit": {
            "type": "number",
            "description": "How many a learner gets each day."
          },
          "resetsAt": {
            "type": "string",
            "description": "When the count starts again, in Bangkok time."
          }
        },
        "required": [
          "analysesLeft",
          "analysesLimit",
          "resetsAt"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "confirmation": {
            "type": "string",
            "enum": [
              "DELETE"
            ],
            "description": "Exactly \"DELETE\". Deletion is permanent, so it is never the result of one stray request (FR-007)."
          }
        },
        "required": [
          "confirmation"
        ]
      },
      "QuestionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "type": "number",
            "description": "Which of the session’s questions this is."
          },
          "photoUrl": {
            "type": "string",
            "nullable": true,
            "description": "A signed link to the world’s photo (P4)."
          },
          "box": {
            "$ref": "#/components/schemas/HighlightBoxDto"
          }
        },
        "required": [
          "id",
          "position",
          "box"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "GAME",
              "REVIEW"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "IN_PROGRESS",
              "COMPLETED",
              "ABANDONED"
            ]
          },
          "worldId": {
            "type": "string",
            "nullable": true,
            "description": "The world being played; empty for a review."
          },
          "answeredCount": {
            "type": "number"
          },
          "questionCount": {
            "type": "number"
          },
          "nextQuestion": {
            "nullable": true,
            "description": "What to ask next; empty when nothing is left to ask.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/QuestionDto"
              }
            ]
          },
          "startedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "answeredCount",
          "questionCount",
          "startedAt"
        ]
      },
      "StartSessionDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "GAME"
            ]
          },
          "worldId": {
            "type": "string",
            "format": "uuid",
            "description": "The world to play (FR-030)."
          }
        },
        "required": [
          "kind",
          "worldId"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      }
    }
  }
}
