              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "photo"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
